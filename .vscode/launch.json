{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (J-Link GDB Server)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/watch_app.elf",
            "servertype": "jlink",
            "device": "STM32F411CE",
            "interface": "swd",
            "serverArgs": ["-speed", "400"],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "preLaunchTask": "build",
            "svdFile": "/opt/ST/STM32CubeCLT_1.21.0/STMicroelectronics_CMSIS_SVD/STM32F411.svd"
        },
        {
            "name": "\u274c OpenOCD + J-Link (not working - no JLink support in OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/watch_app.elf",
            "servertype": "openocd",
            "serverpath": "/opt/homebrew/bin/openocd",
            "configFiles": [
                "${workspaceFolder}/stm32f411ceu6.cfg"
            ],
            "device": "STM32F411CE",
            "interface": "swd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "preLaunchTask": "build",
            "svdFile": "/opt/ST/STM32CubeCLT_1.21.0/STMicroelectronics_CMSIS_SVD/STM32F411.svd"
        }
    ]
}