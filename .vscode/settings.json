{
    "C_Cpp.workspaceSymbols": false,
    "cmake.configureOnEdit": true,
    "cmake.buildBeforeRun": true,
    "cmake.generator": "Ninja",
    "cmake.kitsFile": "${workspaceFolder}/.vscode/cmake-kits.json",
    "cortex-debug.armToolchainPath": "/opt/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin",
    "cortex-debug.openocdPath": "/opt/homebrew/bin/openocd",
    "cortex-debug.JLinkGDBServerPath": "/usr/local/bin/JLinkGDBServer",
    "files.associations": {
        "*.s": "asm"
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}"
    ],
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/Core/Inc",
        "${workspaceFolder}/Drivers/**",
        "${workspaceFolder}/APP",
        "${workspaceFolder}/BSP",
        "${workspaceFolder}/Middlewares/**",
        "${workspaceFolder}/System"
    ]
}
